# Everything here is development-only and must not reach a release zip.
# `wp dist-archive .` reads this file.
.git
.gitignore
.github
.wordpress-org
.distignore
.wp-env.json
.wp-env.override.json
.dev
.phpunit.cache
.phpunit.result.cache
phpunit.xml.dist
phpunit.phar
phpunit-*.phar
tests
phpcs.xml.dist
.phpcs.xml.dist
composer.json
composer.lock

# vendor/ holds dev tooling only — this plugin has no runtime dependencies and
# loads no autoloader. It is listed here as well as in .gitignore because
# `wp dist-archive` reads the working directory rather than git, so a local
# `composer install` before packaging would otherwise ship the whole tree.
vendor
node_modules
README.md
.DS_Store

# Working notes and tooling. These are tracked in git because they belong to the
# repository, and excluded here because they belong to nobody who installs the
# plugin. bin/ especially: the beta deploy script carries an SSH login, and this
# file is the only thing standing between it and a public zip on wordpress.org.
CLAUDE.md
.claude
bin
