<?xml version="1.0" encoding="UTF-8"?>
<!--
  Run with a downloaded phar; there is no Composer dependency:

    curl -sLO https://phar.phpunit.de/phpunit-11.phar
    php phpunit-11.phar

  tests/bootstrap.php stubs the dozen WordPress string helpers the pure logic
  touches, so this needs no database and no WordPress checkout. Integration
  behaviour is verified under wp-env instead.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnWarning="true"
         failOnDeprecation="true"
         cacheDirectory=".phpunit.cache">
	<testsuites>
		<testsuite name="post-portal">
			<directory>tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
